<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="prototype_base">
    <!-- Match the X500 spawn convention: vehicle COM starts 24 cm above ground. -->
    <pose>0 0 0.24 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="base_link">
      <inertial>
        <mass>0.779996</mass>
        <inertia>
          <ixx>0.00229997</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00229997</iyy><iyz>0</iyz><izz>0.00359994</izz>
        </inertia>
      </inertial>
      <gravity>true</gravity>
      <velocity_decay/>
      <visual name="center_plate">
        <geometry><box><size>0.10 0.08 0.018</size></box></geometry>
        <material><ambient>0.12 0.14 0.18 1</ambient><diffuse>0.18 0.21 0.25 1</diffuse></material>
      </visual>
      <visual name="front_left_arm">
        <pose>0 0 0 0 0 0.7853981634</pose>
        <geometry><box><size>0.25 0.012 0.012</size></box></geometry>
        <material><ambient>0.12 0.14 0.18 1</ambient><diffuse>0.18 0.21 0.25 1</diffuse></material>
      </visual>
      <visual name="front_right_arm">
        <pose>0 0 0 0 0 -0.7853981634</pose>
        <geometry><box><size>0.25 0.012 0.012</size></box></geometry>
        <material><ambient>0.12 0.14 0.18 1</ambient><diffuse>0.18 0.21 0.25 1</diffuse></material>
      </visual>
      <collision name="center_collision">
        <geometry><box><size>0.10 0.08 0.018</size></box></geometry>
      </collision>
      <collision name="arm_collision_0">
        <pose>0 0 0 0 0 0.7853981634</pose>
        <geometry><box><size>0.25 0.012 0.012</size></box></geometry>
      </collision>
      <collision name="arm_collision_1">
        <pose>0 0 0 0 0 -0.7853981634</pose>
        <geometry><box><size>0.25 0.012 0.012</size></box></geometry>
      </collision>

      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id><always_on>true</always_on><update_rate>50</update_rate>
        <air_pressure><pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure></air_pressure>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id><always_on>true</always_on><update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><stddev>3e-7</stddev></noise></x>
          <y><noise type="gaussian"><stddev>3e-7</stddev></noise></y>
          <z><noise type="gaussian"><stddev>3e-7</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id><always_on>true</always_on><update_rate>250</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <gz_frame_id>base_link</gz_frame_id><always_on>true</always_on><update_rate>30</update_rate>
      </sensor>
    </link>

    <!-- FlightLxx B-allocation motor locations [x,y] in FLU order. -->
    <link name="rotor_0">
      <pose>0.08838834765 0.08838834765 0.06 0 0 0</pose>
      <inertial><mass>0.000001</mass><inertia><ixx>1e-9</ixx><iyy>1e-9</iyy><izz>1e-9</izz></inertia></inertial>
      <visual name="prop_visual"><geometry><cylinder><radius>0.063</radius><length>0.001</length></cylinder></geometry><material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <link name="rotor_1">
      <pose>0.08838834765 -0.08838834765 0.06 0 0 0</pose>
      <inertial><mass>0.000001</mass><inertia><ixx>1e-9</ixx><iyy>1e-9</iyy><izz>1e-9</izz></inertia></inertial>
      <visual name="prop_visual"><geometry><cylinder><radius>0.063</radius><length>0.001</length></cylinder></geometry><material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <link name="rotor_2">
      <pose>-0.08838834765 -0.08838834765 0.06 0 0 0</pose>
      <inertial><mass>0.000001</mass><inertia><ixx>1e-9</ixx><iyy>1e-9</iyy><izz>1e-9</izz></inertia></inertial>
      <visual name="prop_visual"><geometry><cylinder><radius>0.063</radius><length>0.001</length></cylinder></geometry><material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <joint name="rotor_2_joint" type="revolute"><parent>base_link</parent><child>rotor_2</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <link name="rotor_3">
      <pose>-0.08838834765 0.08838834765 0.06 0 0 0</pose>
      <inertial><mass>0.000001</mass><inertia><ixx>1e-9</ixx><iyy>1e-9</iyy><izz>1e-9</izz></inertia></inertial>
      <visual name="prop_visual"><geometry><cylinder><radius>0.063</radius><length>0.001</length></cylinder></geometry><material><ambient>0.10 0.10 0.10 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <joint name="rotor_3_joint" type="revolute"><parent>base_link</parent><child>rotor_3</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
  </model>
</sdf>
